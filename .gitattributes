* text=auto

# Keep source and documentation stable across Windows, macOS and Linux checkouts.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.qml text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf

# Native Windows launchers are easier to use with Windows line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
